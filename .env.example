# ===================================================
# LAUNDRY SUITE — SUPABASE ENVIRONMENT VARIABLES
# ===================================================

# 1. Buka dashboard Supabase (https://app.supabase.com)
# 2. Buat Project Baru (misal: "laundry-suite-db")
# 3. Buka Project Settings -> API
# 4. Salin Project URL dan anon public key ke variabel di bawah:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================================================
# MIDTRANS PAYMENT GATEWAY CONFIGURATION
# ===================================================
# Dapatkan Server Key & Client Key dari https://dashboard.midtrans.com/
# Mode: "false" untuk Sandbox/Testing, "true" untuk Production Live

VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
VITE_MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
VITE_MIDTRANS_IS_PRODUCTION=false
